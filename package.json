{
  "name": "branch-review",
  "version": "0.6.13",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test test/*.test.mjs",
    "test:live": "node test/live.mjs",
    "desktop": "electron .",
    "dev": "node desktop/dev.cjs",
    "package:desktop": "node desktop/package.mjs",
    "installer": "node desktop/build-installer.cjs",
    "appimage": "electron-builder --config desktop/installer.json --linux AppImage --x64 --publish never"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  },
  "main": "desktop/main.cjs",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "axe-core": "^4.14.0"
  },
  "description": "Review and test Git branch changes in isolated local previews",
  "author": "Joshua Rice"
}
